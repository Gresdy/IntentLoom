{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for IntentLoom",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    "log:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "process:allow-exit",
    "store:allow-clear",
    "store:allow-delete",
    "store:allow-entries",
    "store:allow-get",
    "store:allow-has",
    "store:allow-keys",
    "store:allow-length",
    "store:allow-load",
    "store:allow-reset",
    "store:allow-save",
    "store:allow-set",
    "store:allow-values",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "updater:allow-install",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
